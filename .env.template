# Exchange API Keys
# BINANCE_ENV selects the venue the keys belong to:
#   live    = real Binance USDT-M Futures (fapi.binance.com)        -> real money
#   testnet = Futures Testnet (testnet.binancefuture.com)            -> paper money, separate keys
#   demo    = Binance demo trading (demo-fapi.binance.com)           -> paper money, separate keys
# A testnet/demo key used with BINANCE_ENV=live fails with -2015 / -2008 "Invalid API-key".
BINANCE_ENV=testnet
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ----------------------------------------------------------------------------
# AI decision layer (LLM provider)
# ----------------------------------------------------------------------------
# Provider selection: anthropic (Claude, default) | openai (DeepSeek/Kimi/any
# OpenAI-compatible API) | auto (anthropic if ANTHROPIC_API_KEY is set, else openai)
LLM_PROVIDER=anthropic

# --- Claude (Anthropic) --- get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=         # wrkspc_... ONLY if the key is not scoped to a workspace (API returns 400 asking for anthropic-workspace-id); from platform.claude.com/settings/workspaces
LLM_MODEL=claude-sonnet-5-5     # or claude-opus-5-5 (strongest), claude-haiku-5-5 (cheapest)
LLM_EFFORT=medium               # low | medium | high | xhigh | max (Claude has no temperature param)
LLM_TIMEOUT_SEC=60              # per-request timeout; the call blocks the trading loop
LLM_MAX_TOKENS=1024

# --- OpenAI-compatible alternative (set LLM_PROVIDER=openai) ---
# Kimi K3 / Moonshot (note: kimi-k3 requires temperature=1):
# LLM_API_KEY=
# LLM_MODEL=kimi-k3
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_TEMPERATURE=1.0
# DeepSeek:
# DEEPSEEK_API_KEY=              # legacy name, still honoured
# LLM_MODEL=deepseek-v4-pro
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TEMPERATURE=0.1

# Optional: If you need OKX for reference or testing
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=

# Strategy Parameters (override YAML config)
EQUITY=10000                     # Fallback capital in USDT (live balance is used when available)
LEVERAGE=5                       # Exchange leverage set on BTCUSDT at startup (BINANCE_LEVERAGE overrides); notional is capped at 2x equity anyway
BINANCE_MARGIN_TYPE=isolated     # isolated | cross (set on BTCUSDT at startup; cannot change while a position is open)
BASE_POSITION_USDT=100          # Legacy; sizing is risk-based (RISK_PER_TRADE_PCT of live equity over the SL distance)

# Risk Management
MAX_POSITION_RATIO=0.10         # Max 10% of equity per position
HIGH_CONFIDENCE_MULTIPLIER=1.5
MEDIUM_CONFIDENCE_MULTIPLIER=1.0
LOW_CONFIDENCE_MULTIPLIER=0.5
TREND_STRENGTH_MULTIPLIER=1.2

# Trading Parameters
TIMEFRAME=15m                    # Bar interval (5m, 15m, 1h, etc.)
TIMER_INTERVAL_SEC=900          # Update frequency in seconds (900 = 15 min)
MIN_CONFIDENCE_TO_TRADE=MEDIUM  # LOW, MEDIUM, HIGH

# Exit management & resilience
NATIVE_EXITS=true               # exchange-side SL/TP algo orders (survive restarts); false = legacy emulated bracket
LLM_ASYNC=true                  # run Claude/sentiment/regime calls on a worker thread so fills/stops are never delayed
POSITION_STATE_FILE=logs/position_state.json   # persisted exit state used to re-adopt a position after restart

# Testing
TEST_MODE=false                 # true = signal-only mode: full pipeline runs, signals logged to logs/signal_log.jsonl, NO orders placed
DRY_RUN=false                   # alias of TEST_MODE
SIGNAL_ONLY_MODE=false          # same as above (Phase 2 calibration mode)
AUTO_CONFIRM=false              # true = skip the interactive "are you sure" prompt (needed for systemd)
# FORCE_SIGNAL=BUY              # paper venues ONLY (refused on BINANCE_ENV=live): bypass the LLM for FORCE_SIGNAL_CYCLES cycles to exercise the order path
# FORCE_SIGNAL_CYCLES=1

# Logging
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/deepseek_strategy.log

# Monitoring
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
