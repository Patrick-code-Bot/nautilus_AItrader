# ============================================================================
# LIVE TRADING CONFIGURATION - conservative first-month defaults
# Copy to .env (chmod 600), fill in the keys, run `python tools/preflight_live.py`,
# and only then set LIVE_TRADING_ACK=true.
# ============================================================================

# --- Venue & keys (LIVE keys: Enable Futures, NO withdrawals, IP-restricted to this server) ---
BINANCE_ENV=live
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_LEVERAGE=5                  # exchange leverage on BTCUSDT (notional is capped at MAX_POSITION_LEVERAGE x equity anyway)
BINANCE_MARGIN_TYPE=isolated        # losses capped at the position's margin

# --- Explicit acknowledgement that this trades real money (main_live refuses to start without it) ---
LIVE_TRADING_ACK=false

# --- AI decision layer ---
# Anthropic's API is only offered in supported countries (anthropic.com/supported-countries);
# from an unsupported region it returns 403 "Request not allowed". In that case use an
# OpenAI-compatible provider that serves your region (block B) - do NOT proxy/VPN the calls.
#
# A) Claude (Anthropic)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=             # only if the key is not scoped to a workspace
LLM_MODEL=claude-opus-5-5           # claude-sonnet-5-5 halves cost (~$1/day vs ~$2/day at 15-min cadence)
LLM_EFFORT=medium
#
# B) DeepSeek (or Kimi/Moonshot: LLM_MODEL=kimi-k3, LLM_BASE_URL=https://api.moonshot.cn/v1, LLM_TEMPERATURE=1.0)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-pro
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TEMPERATURE=0.1
#
LLM_TIMEOUT_SEC=60
LLM_MAX_TOKENS=1024
LLM_ASYNC=true

# --- Strategy cadence ---
TIMEFRAME=15m
TIMER_INTERVAL_SEC=900
MIN_CONFIDENCE_TO_TRADE=MEDIUM      # HIGH = effectively no trades (Opus 5.5 never issued HIGH in the Oct-2026 replay)
REGIME_FILTER_ENABLED=true

# --- Risk (first month: half the default risk) ---
RISK_PER_TRADE_PCT=0.005            # 0.5% of live equity risked per trade (SL-distance based sizing)
MAX_POSITION_LEVERAGE=1.5           # position notional <= 1.5x live equity
DAILY_LOSS_LIMIT_PCT=0.03           # -3% in a UTC day -> 24h pause
MAX_CONSECUTIVE_LOSSES=4            # 4 losing closes in a row -> 24h pause
LOSS_PAUSE_HOURS=24
MAX_TOTAL_DRAWDOWN_PCT=0.10         # -10% from equity peak -> HALT until RESET_RISK_STATE=true
MAX_CONSECUTIVE_SAME_SIGNAL=5

# --- Exits ---
NATIVE_EXITS=true                   # exchange-side SL/TP (survive restarts)
USE_ATR_EXITS=true
SL_ATR_MULTIPLIER=1.5
TP_ATR_MULTIPLIER=3.0
TRAILING_USE_ATR=true
TRAILING_ACTIVATION_ATR=1.0
TRAILING_DISTANCE_ATR=1.0
TRAILING_UPDATE_THRESHOLD_ATR=0.25

# --- Safety flags (all must be false/unset for live) ---
TEST_MODE=false
DRY_RUN=false
SIGNAL_ONLY_MODE=false
AUTO_CONFIRM=true                   # systemd has no TTY; the LIVE_TRADING_ACK gate is the confirmation

# --- Alerts (strongly recommended for live) ---
ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=INFO
